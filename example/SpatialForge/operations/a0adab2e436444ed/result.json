{
  "section": "pipelines",
  "items": [
    {
      "id": "asset.prepare",
      "version": 1,
      "description": "复用、导入或生成资产，保留来源和坐标约定。",
      "inputs": {
        "intent": "object",
        "service_config": "path"
      },
      "outputs": {
        "asset": "AssetBundle"
      },
      "steps": [
        {
          "id": "asset",
          "uses": "spatialforge.asset",
          "arguments": {
            "intent": "$inputs.intent"
          }
        },
        {
          "id": "asset_ready",
          "uses": "spatialforge.observe",
          "arguments": {
            "run_id": "$asset.run_id"
          },
          "await_terminal": true
        }
      ]
    },
    {
      "id": "data.capability",
      "version": 1,
      "description": "按指定能力、任务或267模板目录中的多个模板生产协议绑定数据；pipeline_plan将能力或模板选择转换为selections。",
      "inputs": {
        "selections": "array of template_ids/count/reason",
        "evidence": "optional JSONL",
        "seed": "integer",
        "split": "train/dev/test/sealed"
      },
      "outputs": {
        "questions": "dataset/report and exact per-template counts",
        "package": "public/authority/optional training bundle paths"
      },
      "steps": [
        {
          "id": "questions",
          "uses": "templates.produce",
          "arguments": {
            "selections": "$inputs.selections",
            "evidence": "$inputs.evidence",
            "seed": "$inputs.seed",
            "split": "$inputs.split"
          }
        },
        {
          "id": "package",
          "uses": "data.package",
          "arguments": {
            "dataset": "$questions.dataset"
          }
        }
      ]
    },
    {
      "id": "data.package",
      "version": 1,
      "description": "打包公开题目媒体、私有authority和训练答案，保留协议、分区和数量缺口。",
      "inputs": {
        "dataset": "path"
      },
      "outputs": {
        "public_bundle": "path",
        "authority_bundle": "path",
        "training_bundle": "optional path"
      },
      "steps": [
        {
          "id": "package",
          "uses": "data.package",
          "arguments": {
            "dataset": "$inputs.dataset"
          }
        }
      ]
    },
    {
      "id": "scene.capture",
      "version": 1,
      "description": "采集已有 SceneProgram 的真实图像、深度、实例、姿态和交互，不重复创建场景。",
      "inputs": {
        "scene_program_path": "path",
        "capture_options": "optional object",
        "service_config": "path"
      },
      "outputs": {
        "capture": "CaptureEvidence"
      },
      "steps": [
        {
          "id": "capture",
          "uses": "spatialforge.capture",
          "arguments": {
            "scene_program_path": "$inputs.scene_program_path",
            "capture_options": "$inputs.capture_options"
          }
        },
        {
          "id": "capture_ready",
          "uses": "spatialforge.observe",
          "arguments": {
            "run_id": "$capture.run_id"
          },
          "await_terminal": true
        }
      ]
    },
    {
      "id": "scene.create",
      "version": 1,
      "description": "提交场景intent并观察完成状态；复用原参考、资产与场景生产流程。",
      "inputs": {
        "intents": "array of name/description/split with optional layout/scene_program_path/target_items",
        "service_config": "path"
      },
      "outputs": {
        "scene": "submitted run_id",
        "scene_ready": "terminal state with tasks and artifact references"
      },
      "steps": [
        {
          "id": "scene",
          "uses": "spatialforge.start",
          "arguments": {
            "intents": "$inputs.intents"
          }
        },
        {
          "id": "scene_ready",
          "uses": "spatialforge.observe",
          "arguments": {
            "run_id": "$scene.run_id"
          },
          "await_terminal": true
        }
      ],
      "execution": "existing single desktop Isaac queue"
    },
    {
      "id": "scene.refine",
      "version": 1,
      "description": "从已有采集和修改要求生成新版本，保留来源场景和旧证据。",
      "inputs": {
        "parent_task_id": "string",
        "name": "string",
        "description": "string",
        "service_config": "path"
      },
      "outputs": {
        "scene": "SceneProgram",
        "capture": "CaptureEvidence"
      },
      "steps": [
        {
          "id": "refine",
          "uses": "spatialforge.refine",
          "arguments": {
            "parent_task_id": "$inputs.parent_task_id",
            "name": "$inputs.name",
            "description": "$inputs.description"
          }
        },
        {
          "id": "refine_ready",
          "uses": "spatialforge.observe",
          "arguments": {
            "run_id": "$refine.run_id"
          },
          "await_terminal": true
        }
      ]
    }
  ],
