  "source": "89tasks-267templates-v1.0-design",
  "capability_policy": "Catalog links select candidates; task operation and measurement variant define measured scope.",
  "question_authoring": {
    "schema": "benchforge.question-writing/v1",
    "instructions": "每题提交 question_spec：简短自然题干 stem、公开已知条件 context、必要作答规则 conditions、候选 options、作答说明 response、逐项媒体标题 media_labels，以及与 parameters 完全一致的 parameter_bindings。题干先说看什么和问什么；采集说明、坐标定义、单位和容差分别放在条件中，必要条件不能藏在技术详情。对象称呼必须对应公开图片中的真实名称或编号；禁止凭空命名物体。禁止把内部运行号、路径、相机代码、原始字典或列表拼进题干。中心、采样点、参照轴等若用于作答，必须在公开媒体中提供对应标记或可用条件。保留准确模板的目标、参照系、单位、容差、候选和输出合同；改表达不能改变问题。无需模型判断题目质量。程序检查字段与绑定，并逐模板实际看图检查代表题。",
    "evidence_field": "question_spec",
    "required_fields": [
      "stem",
      "context",
      "conditions",
      "options",
      "response",
      "media_labels",
      "parameter_bindings"
    ],
    "example": {
      "schema": "benchforge.question-writing/v1",
      "stem": "看图1，标记A的物体在标记B的哪一侧？",
      "context": [
        "图中编号用于识别物体。"
      ],
      "conditions": [
        "以画面为参照，按图中中心标记判断方向。"
      ],
      "options": [
        "左侧",
        "右侧",
        "上方",
        "下方"
      ],
      "response": "按当前模板的输出合同提交一个方向。",
      "media_labels": [
        "图1：场景与物体中心标记"
      ],
      "parameter_bindings": "copy the exact evidence parameters object"
    },
    "validation_scope": "writing structure and exact source bindings; human answerability requires real media review"
  }
}